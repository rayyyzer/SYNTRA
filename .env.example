# Samsung PRISM GenAI Hackathon 3.0 - Theme 2 (SYNTRA) Configuration
# Copy this file to .env to configure local settings.
# NOTE: The engine runs 100% offline with zero external network dependencies
# because precomputed embeddings and targeted reasoner cache are bundled.

# Optional: Google Gemini API Key for live targeted candidate reasoning
# If not provided, the engine safely and deterministically uses bundled cache & hybrid retrieval.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini Reasoning Mode: 'selective' (default), 'targeted', 'confidence', 'always', or 'off'
GEMINI_MODE=selective

# Gemini API Request Timeout in seconds (default: 2.5)
GEMINI_TIMEOUT_SEC=2.5

# Development & Playground UI Settings
# Set to 'true' to enable the SYNTRA developer console at /dev/playground
THEME2_DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
